extern void game_logic ( void )
{
// static data
static int state = STATE_START;
// update
_pfn_states[state]();
// state transition
switch (state)
{
case STATE_START:
if ( device_state.pc10 )
state = STATE_P1_PLACE;
break;
// player 1 places boats
case STATE_P1_PLACE:
// transition
if ( 0 )
state = STATE_P2_PLACE;
break;
// player 2 places boats
case STATE_P2_PLACE:
// transition
if ( 0 )
state = STATE_P2_PLACE;
break;
// player 1 takes a shot
case STATE_P1_TURN:
// transition
if ( 0 )
state = STATE_P2_TURN;
else if ( 0 )
state = STATE_RESULT;
break;
// player 2 takes a shot
case STATE_P2_TURN:
// transition
if ( 0 )
state = STATE_P1_TURN;
else
state = STATE_RESULT;
break;
// game over
case STATE_RESULT:
if ( device_state.pc10 )
state = STATE_START;
break;
// unknown state -> reset
default:
state = STATE_START;
break;
}
// done
return;
}
